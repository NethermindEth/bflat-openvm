<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- No managed assembly: the package ships a native static library and the
         bflat manifest that describes it. NU5128 is the "no lib/ folder for the
         target framework" warning, which is expected here. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Description>OpenVM zkVM accelerators for the Nethermind guest for OpenVM</Description>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageId>Nethermind.OpenVM.Runtime</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nethermind.io</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>openvm;zkvm;riscv64</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/nethermindeth/bflat-openvm</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- The static library, the bflat manifests and the platform files (entry
         object, linker scripts). The manifests name the other files by bare
         name, so all of them stay side by side. -->
    <None Update="runtimes/linux-riscv64/native/*">
      <Pack>true</Pack>
      <PackagePath>%(RelativeDir)%(Filename)%(Extension)</PackagePath>
    </None>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
