<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- No managed assembly: the package ships a native static library and the
         bflat manifest that describes it. NU5128 is the "no lib/ folder for the
         target framework" warning, which is expected here. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Description>OpenVM zkVM accelerators for the Nethermind guest for OpenVM</Description>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageId>Nethermind.OpenVM.Runtime</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nethermind.io</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>openvm;zkvm;riscv64</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/nethermindeth/bflat-openvm</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Update="runtimes/linux-riscv64/native/libopenvm.a">
      <Pack>true</Pack>
      <PackagePath>%(RelativeDir)%(Filename)%(Extension)</PackagePath>
    </None>
    <None Update="libopenvm.bflat.manifest">
      <Pack>true</Pack>
      <PackagePath>runtimes/linux-riscv64/native/%(Filename)%(Extension)</PackagePath>
    </None>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
